# Copy to .env for local overrides. On Hostinger, set these as environment variables.

# Canonical origin used for canonical URLs and sitemap.xml
SITE_URL=https://thewaterrestorationgroup.com

# Review mode (default: on). While "true" the site:
#  - sends <meta name="robots" content="noindex"> and a blocking robots.txt
#  - shows internal review notes (pending content, unverified items)
# Set to "false" only after WRG approves content, photos and legal text.
PUBLIC_REVIEW_MODE=true

# Port for server.mjs (Hostinger injects PORT automatically)
PORT=3000
