---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ReviewNote from '../components/ReviewNote.astro';
import { company, routes } from '../data/site';
---
<BaseLayout title="Thank You" description="Thank you for contacting The Water Restoration Group." noindex page="thank-you">
  <section class="sec ihero bg-canvas" aria-labelledby="t">
    <div class="wrap">
      <div class="art-head">
        <p class="eyebrow">Thank you</p>
        <h1 class="h1" id="t">Thank you for contacting WRG.</h1>
        <p class="lead" style="max-width: 56ch">If your property needs attention now, call the 24/7 phone team. Calling is the fastest way to talk about the damage.</p>
        <div class="cta-row">
          <a class="btn btn-call btn-lg" href={company.phone.href}><Icon name="phone" /><span>Call now</span><span class="num">{company.phone.display}</span></a>
          <a class="btn btn-ghost btn-lg" href={routes.home}><span>Back to home</span><Icon name="arrow" class="arr" /></a>
        </div>
        <ReviewNote>The site has no forms yet, so nothing links here. Keep this page as the confirmation step if WRG approves a contact form later.</ReviewNote>
      </div>
    </div>
  </section>
</BaseLayout>
