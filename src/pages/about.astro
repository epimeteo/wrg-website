---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { aboutHero, projectMain as pm } from '../data/photos';
import { reviewMode } from '../data/site';
---
<BaseLayout title="About" description="The Water Restoration Group provides property restoration and reconstruction from offices in Miami, West Palm Beach and Smyrna." active="about">

    <section class="sec ihero bg-canvas" aria-labelledby="t">
      <div class="wrap">
        <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li><span aria-current="page">About</span></li></ol></nav>
        <div class="ihero-grid" style="align-items: center">
          <div class="ihero-copy">
            <p class="eyebrow">About WRG</p>
            <h1 class="h1" id="t">Restoring properties. <span class="soft">Supporting people.</span></h1>
            <p class="lead">Property restoration is about more than the work on a building. It also involves the people making decisions, coordinating access and waiting to understand what happens next. WRG brings restoration and reconstruction services into that conversation.</p>
            <div class="cta-row"><a class="lnk" href="/projects/">See documented projects</a><a class="lnk" href="/reviews/">Read client reviews</a></div>
          </div>
          <Photo src={aboutHero.src} alt={aboutHero.alt} max={aboutHero.max} position={aboutHero.pos} sizes="(min-width: 1024px) 480px, 100vw" style="aspect-ratio: 5 / 4; border-radius: 48px clamp(80px, 10cqi, 150px) 48px 48px" depth={0.07} priority />
        </div>
      </div>
    </section>

    <!-- Proof first: documented projects -->
    <section class="sec bg-white" aria-labelledby="pj">
      <div class="wrap">
        <div class="sec-head">
          <div class="stack"><p class="eyebrow">Proof of work</p><h2 class="h2" id="pj">Documented projects</h2></div>
          <div class="aside stack g12"><p class="muted">Each project shows where the work took place and the services described in WRG’s records.</p><a class="lnk" href="/projects/">All projects &amp; case studies</a></div>
        </div>
        <div class="proof-strip">
          <article class="pcard rv"><Photo src={pm["icon-bay"].src} alt="" max={600} position={pm["icon-bay"].square} sizes="(min-width: 1024px) 280px, 50vw" /><p class="geo">Edgewater, Miami, FL</p><h3>Icon Bay</h3><p class="xs muted">Water Damage Restoration · Reconstruction</p><a class="lnk stretch small" href="/projects/icon-bay/">Read the case study</a></article>
          <article class="pcard rv d2"><Photo src={pm["gables-waterway-towers"].src} alt="" max={600} position={pm["gables-waterway-towers"].square} sizes="(min-width: 1024px) 280px, 50vw" /><p class="geo">Coral Gables, FL</p><h3>Gables Waterway Towers</h3><p class="xs muted">Fire &amp; Smoke · Water Damage</p><a class="lnk stretch small" href="/projects/gables-waterway-towers/">Read the case study</a></article>
          <article class="pcard rv d3"><Photo src={pm["st-louis-condominium"].src} alt="" max={600} position={pm["st-louis-condominium"].square} sizes="(min-width: 1024px) 280px, 50vw" /><p class="geo">Brickell Key, Miami, FL</p><h3>St. Louis Condominium</h3><p class="xs muted">Mold Remediation</p><a class="lnk stretch small" href="/projects/st-louis-condominium/">Read the case study</a></article>
          <article class="pcard rv d4"><Photo src={pm["south-point-condominium"].src} alt="" max={600} position={pm["south-point-condominium"].square} sizes="(min-width: 1024px) 280px, 50vw" /><p class="geo">Fort Lauderdale, FL</p><h3>South Point Condominium</h3><p class="xs muted">Mold Remediation · Reconstruction</p><a class="lnk stretch small" href="/projects/south-point-condominium/">Read the case study</a></article>
        </div>
      </div>
    </section>

    <!-- How we work -->
    <section class="sec sheet dark" data-tone="dark" aria-labelledby="hw">
      <div class="wrap">
        <div class="sec-head">
          <div class="stack"><p class="eyebrow">How we work</p><h2 class="h2" id="hw">Three commitments behind the work.</h2></div>
          <div class="aside">{reviewMode && <span class="review-flag">Proposed wording, pending WRG approval</span>}</div>
        </div>
        <div class="values">
          <div class="value rv"><b>Clear communication</b><p class="small" style="color: #dcebef">Understand the scope, the current stage and the decisions ahead.</p></div>
          <div class="value rv d2"><b>Respect for the property</b><p class="small" style="color: #dcebef">Plan the work around the spaces affected and the people who use them.</p></div>
          <div class="value rv d3"><b>A documented process</b><p class="small" style="color: #dcebef">Keep relevant project information connected to the work being performed.</p></div>
        </div>
      </div>
    </section>

    <!-- Credentials -->
    <section class="sec bg-canvas" aria-labelledby="cr">
      <div class="wrap">
        <div class="sec-head">
          <div class="stack"><p class="eyebrow">Credentials</p><h2 class="h2" id="cr">Licenses, accreditations and memberships</h2></div>
          <div class="aside">{reviewMode && <span class="review-flag">Shown as published on the current site; each item needs validation before launch</span>}</div>
        </div>
        <div class="lic">
          <div><span class="topic">General Contractor · Florida</span><b>CGC1526082</b><p class="small muted">Holder, validity, scope and jurisdiction pending validation.</p></div>
          <div><span class="topic">Mold Removal · Florida</span><b>MRSR73</b><p class="small muted">Holder, validity, scope and jurisdiction pending validation.</p></div>
        </div>
        <ul class="cred" style="margin-top: 20px">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5.5"></circle><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"></path></svg>Better Business Bureau (BBB)</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5.5"></circle><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"></path></svg>IICRC member</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5.5"></circle><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"></path></svg>EPA Lead-Safe Certified Firm</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5.5"></circle><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"></path></svg>AIA Continuing Education Provider</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5.5"></circle><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"></path></svg>BOMA of Fort Lauderdale and Palm Beaches</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5.5"></circle><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"></path></svg>Community Associations Institute</li>
        </ul>
        <p class="small muted" style="margin-top: 16px; max-width: 80ch">The current site also shows OSHA, EPA, Florida DBPR and Florida Department of Financial Services logos. They stay out until WRG confirms whether each one is a credential, a registration or a reference.</p>
      </div>
    </section>

    <!-- People / Our Experts -->
    {reviewMode && (
    <section class="sec bg-white" id="experts" aria-labelledby="xp">
      <div class="wrap">
        <div class="sec-head">
          <div class="stack"><p class="eyebrow">Our Experts</p><h2 class="h2" id="xp">The people behind the work</h2></div>
          <p class="muted aside">Up to three verified expert profiles, each with real identity, approved photography and confirmed credentials.</p>
        </div>
        <div class="people-empty">
          <div class="person-slot"><figure class="ph"><div class="ph-in"></div></figure><span>Profile 1 · pending approval</span></div>
          <div class="person-slot"><figure class="ph"><div class="ph-in"></div></figure><span>Profile 2 · pending approval</span></div>
          <div class="person-slot"><figure class="ph"><div class="ph-in"></div></figure><span>Profile 3 · pending approval</span></div>
        </div>
        {reviewMode && (<p class="notice" style="margin-top: 24px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16.5v.01"></path></svg><span><b>Internal review:</b> No names, roles or credentials have been approved. This section is shown only in review mode until profiles are confirmed.</span></p>)}
      </div>
    </section>
    )}

    <!-- Reviews preview -->
    <section class="sec bg-mist sheet-top" aria-labelledby="rv">
      <div class="wrap">
        <div class="ctx">
          <div class="stack g16"><p class="eyebrow">Reviews</p><h2 class="h2" id="rv">Experiences shared by WRG clients.</h2><a class="lnk" href="/reviews/">Read client reviews</a></div>
          <figure class="rev" style="margin: 0">
            <blockquote>It is an absolute pleasure to work with WRG. The staff is efficient, courteous, and friendly across the board.</blockquote>
            <footer><cite>Mary M.</cite><span>Testimonial published on thewaterrestorationgroup.com</span>{reviewMode && <span class="review-flag" style="margin-top: 8px; align-self: flex-start">Platform, date and permission pending verification</span>}</footer>
          </figure>
        </div>
      </div>
    </section>

    <section class="sec sheet dark cta-band" data-tone="dark" aria-labelledby="cta">
      <div class="wrap">
        <div class="cta-grid">
          <div class="stack g16"><p class="eyebrow">Offices</p><h2 class="h2" id="cta">Miami · West Palm Beach · Smyrna</h2><a class="lnk" href="/locations/">Find your office</a></div>
          <div class="callcard"><span class="small muted">24/7 Emergency Phone Support</span><a class="num-l" href="tel:+18443799283">(844) 379-9283</a><a class="btn btn-call" href="tel:+18443799283">Call now</a></div>
        </div>
      </div>
    </section>
</BaseLayout>
