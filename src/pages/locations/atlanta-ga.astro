---
import { reviewMode } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Water Damage Restoration in Smyrna & Atlanta" description="Water, fire and mold restoration for homes and businesses in Metro Atlanta from WRG’s office at 5028 S Atlanta Rd SE, Smyrna, GA." active="locations">

    <!-- 1 · Dark local hero with an abstract regional mark (not a map) -->
    <section class="sec ihero sheet dark" data-tone="dark" style="margin-top: 12px" aria-labelledby="t">
      <div class="wrap">
        <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/locations/">Locations</a></li><li><span aria-current="page">Atlanta / Smyrna, GA</span></li></ol></nav>
        <div class="ihero-grid" style="align-items: center">
          <div class="ihero-copy">
            <p class="eyebrow">Metro Atlanta · Smyrna office</p>
            <h1 class="h1" id="t">Water Damage Restoration <span class="soft">in Smyrna &amp; Metro Atlanta</span></h1>
            <p class="lead">From its Smyrna office, WRG supports homeowners and businesses across Metro Atlanta. Whether the damage follows a plumbing failure, storm-related water intrusion or a fire, our phone team is available 24/7 to discuss the situation and the restoration support needed next.</p>
            <div class="cta-row">
              <a class="btn btn-call btn-lg" href="tel:+18443799283"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.6 3.5h2.6l1.6 4.2-2.1 1.3a11.5 11.5 0 0 0 6.3 6.3l1.3-2.1 4.2 1.6v2.6a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z"></path></svg><span>Call now</span><span class="num">(844) 379-9283</span></a>
            </div>
          </div>
          <div class="rmap" aria-hidden="true">
            <span class="ring r1"></span><span class="ring r2"></span><span class="ring r3"></span>
            <span class="pin"></span><span class="pin-l">Smyrna office</span>
            <span class="area-l">Metro Atlanta</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · Office details -->
    <section class="sec bg-canvas" style="--st: clamp(40px, 4cqi, 56px); --sb: clamp(40px, 4cqi, 56px)" aria-labelledby="of">
      <div class="wrap">
        <div class="callout" style="background: #ffffff; border: 1px solid #c8dfe6">
          <div class="stack g8">
            <p class="eyebrow" id="of">Atlanta-area office</p>
            <address class="h3" style="font-weight: 500">5028 S Atlanta Rd SE, Smyrna, GA 30080</address>
            <p class="small muted">Our Atlanta-area office is located in Smyrna. One office, serving the Metro Atlanta market.</p>
          </div>
          <div class="cta-row">
            <a class="btn btn-call" href="tel:+18443799283">Call WRG</a>
            <a class="btn btn-ghost" href="https://www.google.com/maps/search/?api=1&amp;query=5028+S+Atlanta+Rd+SE+Smyrna+GA+30080" target="_blank" rel="noopener">Get directions</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · Georgia context: three property situations -->
    <section class="sec bg-white" aria-labelledby="ctx">
      <div class="wrap">
        <div class="sec-head">
          <div class="stack"><p class="eyebrow">Local context</p><h2 class="h2" id="ctx">A Smyrna office serving the Metro Atlanta area.</h2></div>
          <p class="lead aside">A home, an occupied rental property and an operating business each bring different access and communication needs.</p>
        </div>
        <div class="olist" style="gap: 20px">
          <div class="qbox rv"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 11 12 4l8.5 7"></path><path d="M5.5 9.5V20h13V9.5"></path><path d="M10 20v-5.5h4V20"></path></svg></span><h3 class="h3">A home</h3><p class="muted small">Tell the team what happened, which rooms are affected and who will be at the property.</p></div>
          <div class="qbox alt rv d2"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3.5" width="14" height="17" rx="2.5"></rect><path d="M9 8h1.5M13.5 8H15M9 12h1.5M13.5 12H15M10 20.5V17h4v3.5"></path></svg></span><h3 class="h3">An occupied rental</h3><p class="muted small">Share who coordinates access between the owner, the manager and the people living there.</p></div>
          <div class="qbox rv d3"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V9l8-5 8 5v11"></path><path d="M9 20v-6h6v6"></path></svg></span><h3 class="h3">An operating business</h3><p class="muted small">Explain which spaces are affected and who can coordinate the property assessment.</p></div>
        </div>
        <p class="muted" style="margin-top: 28px; max-width: 70ch">Start by telling our team what happened, which spaces are affected and who can coordinate the property assessment.</p>
      </div>
    </section>

    <!-- 4 · Services + coverage -->
    <section class="sec bg-mist sheet-top" aria-labelledby="sv">
      <div class="wrap">
        <div class="sec-head">
          <div class="stack"><p class="eyebrow">Services</p><h2 class="h2" id="sv">Restoration support across Metro Atlanta</h2></div>
          <div class="aside stack g12"><p class="muted">Service area: Metro Atlanta. Call with the property address to confirm service.</p>{reviewMode && <span class="review-flag">Detailed coverage and availability by service pending confirmation</span>}</div>
        </div>
        <div class="svc-chips">
          <a class="svc-chip" href="/services/water-damage-restoration/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5s6.5 6.6 6.5 11.1a6.5 6.5 0 0 1-13 0C5.5 10.1 12 3.5 12 3.5z"></path></svg>Water damage restoration in Smyrna &amp; Atlanta</a>
          <a class="svc-chip" href="/services/fire-damage-restoration/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c.6 3.2 4.8 5.3 4.8 10a4.8 4.8 0 0 1-9.6 0c0-2.3 1.2-3.8 2.4-4.8.2 1.7 1 2.8 2.1 3.2C11 9 11.3 5.6 12 3z"></path></svg>Fire &amp; smoke restoration</a>
          <a class="svc-chip" href="/services/mold-remediation/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8.5" cy="9" r="3.2"></circle><circle cx="16.5" cy="7.5" r="2"></circle><circle cx="14.5" cy="16" r="3.8"></circle></svg>Mold remediation</a>
          <a class="svc-chip" href="/services/reconstruction/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 11 12 4l8.5 7"></path><path d="M5.5 9.5V20h13V9.5"></path></svg>Reconstruction</a>
          <a class="svc-chip" href="/services/">All services</a>
        </div>
        <div class="related" style="margin-top: 40px">
          <article class="rel-card txt"><p class="topic">Insight · Water damage</p><h3 class="h3">How Long Does Water Damage Restoration Take?</h3><p class="muted small">Drying is one stage. The full timeline also depends on the materials affected and the repairs that follow.</p><a class="lnk stretch" href="/blog/humidity/how-long-does-water-damage-restoration-take/">Read the insight</a></article>
          {reviewMode && (<div class="notice" style="align-self: stretch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16.5v.01"></path></svg><span><b>Internal review:</b> No Georgia project, photo or team profile is confirmed. Florida cases and images are not used as local evidence. The testimonials on wrg-atlanta.com match the corporate site word for word, so they are not shown as Atlanta reviews. Florida licenses CGC1526082 and MRSR73 are not presented as authorization in Georgia.</span></div>)}
        </div>
      </div>
    </section>

    <!-- 5 · FAQ -->
    <section class="sec bg-white" aria-labelledby="fq">
      <div class="wrap">
        <div class="faq-grid">
          <div class="split-head"><p class="eyebrow">Atlanta-area FAQ</p><h2 class="h2" id="fq">About the Smyrna office</h2></div>
          <div class="faq">
            <details open=""><summary>Is your Atlanta-area office located in Smyrna?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg></span></summary><p class="ans">Yes. Our Atlanta-area office is located at 5028 S Atlanta Rd SE, Smyrna, GA 30080. Call our team to discuss service for your property.</p></details>
            <details><summary>How do I know if my part of Metro Atlanta is covered?<span class="pm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg></span></summary><p class="ans">Call (844) 379-9283 with the property address. The team will confirm service for your location.</p></details>
          </div>
        </div>
      </div>
    </section>

    <section class="sec sheet dark cta-band" data-tone="dark" aria-labelledby="cta">
      <div class="wrap">
        <div class="cta-grid">
          <div class="stack g16"><p class="eyebrow">Talk to WRG</p><h2 class="h2" id="cta">Damage to a Metro Atlanta property? Tell us what happened.</h2></div>
          <div class="callcard"><span class="small muted">24/7 Emergency Phone Support</span><a class="num-l" href="tel:+18443799283">(844) 379-9283</a><a class="btn btn-call" href="tel:+18443799283">Call now</a></div>
        </div>
      </div>
    </section>
</BaseLayout>
