---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you are looking for could not be found. Call WRG 24/7 at (844) 379-9283 or return to the home page." active="none" noindex>
    <section class="sec bg-canvas" style="--st: clamp(56px, 7cqi, 112px); --sb: clamp(56px, 7cqi, 112px)" aria-labelledby="t">
      <div class="wrap">
        <div class="nf">
          <div class="stack g24">
            <p class="eyebrow">Error 404</p>
            <h1 class="h1" id="t">We couldn’t find that page.</h1>
            <p class="lead">Explore our services or return to the homepage.</p>
            <div class="cta-row">
              <a class="btn btn-blue btn-lg" href="/">Back to the homepage</a>
              <a class="btn btn-ghost btn-lg" href="/services/">Explore our services</a>
              <a class="lnk" href="/contact/">Contact</a>
            </div>
            <p class="small muted">Need help now? <a class="tel" href="tel:+18443799283">Call (844) 379-9283</a>, 24/7 Emergency Phone Support.</p>
          </div>
          <div class="nf-mark" aria-hidden="true">404</div>
        </div>
      </div>
    </section>
</BaseLayout>
