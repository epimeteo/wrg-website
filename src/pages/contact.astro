---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Call The Water Restoration Group 24/7 at (844) 379-9283, or find the Miami, West Palm Beach and Smyrna office addresses." active="contact">

    <section class="sec ihero bg-canvas" style="--sb: clamp(32px, 3cqi, 48px)" aria-labelledby="t">
      <div class="wrap">
        <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li><span aria-current="page">Contact</span></li></ol></nav>
        <div class="ihero-copy">
          <p class="eyebrow">Contact</p>
          <h1 class="h1" id="t">Talk to WRG, <span class="soft">24/7.</span></h1>
          <p class="lead">Tell our phone team about the property, the damage you have observed and the support you need. For office information, explore our locations below.</p>
        </div>
      </div>
    </section>

    <section class="sec bg-canvas" style="--st: 0px" aria-label="Phone support">
      <div class="wrap">
        <div class="contact-grid">
          <div class="phone-card on-dark">
            <p class="eyebrow">24/7 Emergency Phone Support</p>
            <a class="bignum" href="tel:+18443799283">(844) 379-9283</a>
            <p class="lead">or dial 1 (844) DRY-WATER</p>
            <a class="btn btn-call btn-lg" href="tel:+18443799283"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.6 3.5h2.6l1.6 4.2-2.1 1.3a11.5 11.5 0 0 0 6.3 6.3l1.3-2.1 4.2 1.6v2.6a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z"></path></svg><span>Call now</span></a>
            <div class="alt-line"><span>Additional published line</span><a href="tel:+13056612533">(305) 661-2533</a></div>
          </div>
          <div class="ready">
            <p class="eyebrow">When you call</p>
            <h2 class="h3">Helpful to share</h2>
            <ol>
              <li>The property address</li>
              <li>The type of damage you have observed</li>
              <li>The best contact for access to the property</li>
              <li>Any access restrictions</li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="sec bg-white" aria-labelledby="of">
      <div class="wrap">
        <div class="sec-head"><div class="stack"><p class="eyebrow">Offices</p><h2 class="h2" id="of">Three offices</h2></div><p class="muted aside">24/7 availability refers to phone support. Office visits are not implied.</p></div>
        <div class="loc-cards">
          <div class="ocard"><span class="topic">Corporate headquarters</span><b>Miami, FL</b><address>555 NW 95th St, Miami, FL 33150</address><div class="cta-row" style="margin-top: 8px"><a class="lnk" href="/locations/miami-fl/">View this location</a><a class="lnk" href="https://www.google.com/maps/search/?api=1&amp;query=555+NW+95th+St+Miami+FL+33150" target="_blank" rel="noopener">Get directions</a></div></div>
          <div class="ocard"><span class="topic">Palm Beach County</span><b>West Palm Beach, FL</b><address>1705 Donna Road, Unit #10, West Palm Beach, FL 33409</address><div class="cta-row" style="margin-top: 8px"><a class="lnk" href="/locations/west-palm-beach-fl/">View this location</a><a class="lnk" href="https://www.google.com/maps/search/?api=1&amp;query=1705+Donna+Road+Unit+10+West+Palm+Beach+FL+33409" target="_blank" rel="noopener">Get directions</a></div></div>
          <div class="ocard"><span class="topic">Metro Atlanta</span><b>Atlanta / Smyrna, GA</b><address>5028 S Atlanta Rd SE, Smyrna, GA 30080</address><div class="cta-row" style="margin-top: 8px"><a class="lnk" href="/locations/atlanta-ga/">View this location</a><a class="lnk" href="https://www.google.com/maps/search/?api=1&amp;query=5028+S+Atlanta+Rd+SE+Smyrna+GA+30080" target="_blank" rel="noopener">Get directions</a></div></div>
        </div>
        <div class="duo" style="margin-top: 20px">
          <div class="duo-card"><p class="topic">Before you call</p><a class="lnk stretch" href="/faqs/">Read common questions</a></div>
          <div class="duo-card"><p class="topic">See the work</p><a class="lnk stretch" href="/projects/">Browse documented projects</a></div>
        </div>
      </div>
    </section>
</BaseLayout>
