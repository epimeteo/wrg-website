---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { blogFeatured } from '../../data/photos';
import ReviewFlag from '../../components/ReviewFlag.astro';
import { getInsights, topicsOf, formatDate } from '../../data/insights';
import { services, serviceHref } from '../../data/services';
import { company } from '../../data/site';
const all = await getInsights();
const [featured, ...more] = all;
const topics = topicsOf(all);
const related = services.filter((s) => ['water', 'fire', 'mold', 'environmental'].includes(s.key));
---
<BaseLayout title="Insights" description="Practical information about water damage, mold, fire restoration, hurricane preparedness and specialized cleanup, and the questions property owners and managers often bring to WRG." active="blog" page="insights">
  <section class="sec ihero bg-canvas" aria-labelledby="t">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Insights' }]} />
      <div class="ihero-grid">
        <div class="ihero-copy">
          <p class="eyebrow">Insights</p>
          <h1 class="h1" id="t">Clear answers for property recovery.</h1>
          <p class="lead">Explore practical information about restoration, project planning and the questions property owners and managers often bring to WRG.</p>
        </div>
        <nav class="stack g12" aria-label="Topics">
          <p class="aside-h" style="color: var(--muted)">Topics</p>
          <div class="topics">
            {topics.map((t) => <a href={`/blog/${t.slug}/`}>{t.label}<span class="count">{t.count}</span></a>)}
          </div>
        </nav>
      </div>
    </div>
  </section>

  <section class="sec bg-white" style="--st: clamp(40px, 4cqi, 56px)" aria-labelledby="ft">
    <div class="wrap">
      <article class="ifeat on-dark">
        <Photo src={blogFeatured.src} alt={blogFeatured.alt} max={blogFeatured.max} position={blogFeatured.pos} sizes="(min-width: 1024px) 600px, 100vw" depth={0.05} />
        <div class="ifeat-body">
          <p class="topic">Featured · {featured.label}</p>
          <h2 class="h2" id="ft">{featured.title}</h2>
          <p class="lead">{featured.summary}</p>
          <a class="lnk stretch" href={featured.href}>Read the insight<Icon name="arrow" /></a>
        </div>
      </article>

      <div class="sec-head" style="margin-top: clamp(48px, 6cqi, 80px)">
        <div class="stack"><h2 class="h2" id="all">All insights</h2></div>
        <p class="muted aside">{all.length} articles, the newest first. Filter by topic above.</p>
      </div>
      <div class="alist">
        {more.map((a) => (
          <article class="arow">
            <div class="stack g8"><p class="topic">{a.label}</p>{a.published && <p class="xs muted"><time datetime={a.published.toISOString().slice(0, 10)}>{formatDate(a.published)}</time></p>}</div>
            <div class="stack g8"><h3>{a.title}</h3><p class="muted small">{a.summary}</p></div>
            <a class="go stretch" href={a.href} aria-label={`Read: ${a.title}`}><Icon name="arrow" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec bg-mist sheet-top" aria-labelledby="au">
    <div class="wrap">
      <div class="duo">
        <div class="duo-card">
          <p class="topic">Authors &amp; reviewers</p>
          <h2 class="h3" id="au">Written from WRG’s field experience.</h2>
          <p class="muted small">Articles carried over from WRG’s previous site keep their original publication date. New articles show a byline once the author and reviewer are confirmed.</p>
          <ReviewFlag>New editorial articles: WRG’s review, author and date pending. Migrated articles: author per article to confirm</ReviewFlag>
        </div>
        <div class="duo-card">
          <p class="topic">Related services</p>
          <div class="svc-chips">
            {related.map((s) => <a class="svc-chip" href={serviceHref(s.slug)}>{s.name}</a>)}
          </div>
        </div>
      </div>
      <div class="callout" style="margin-top: 20px; background: var(--white)">
        <p class="muted">Have a question about your own property? The 24/7 phone team can talk it through.</p>
        <a class="lnk" href={company.phone.href}>Call {company.phone.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>
