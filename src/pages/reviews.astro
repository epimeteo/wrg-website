---
import { reviewMode } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { googleReviews, googleProfileUrl } from '../data/reviews';
const delay = ['', 'd2', 'd3'];
---
<BaseLayout title="Reviews" description="A selection of Google reviews left by WRG clients in South Florida." active="about">

    <section class="sec ihero bg-canvas" aria-labelledby="t">
      <div class="wrap">
        <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/about/">About</a></li><li><span aria-current="page">Reviews</span></li></ol></nav>
        <div class="ihero-grid">
          <div class="ihero-copy">
            <p class="eyebrow">Reviews</p>
            <h1 class="h1" id="t">Experiences shared by <span class="soft">WRG clients.</span></h1>
            <p class="lead">A selection of reviews that clients left on WRG’s Google Business Profile in South Florida, quoted word for word.</p>
            {googleProfileUrl && <a class="btn btn-blue" href={googleProfileUrl} rel="noopener">Read all reviews on Google</a>}
          </div>
          {reviewMode && (<div class="notice"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16.5v.01"></path></svg><span><b>Internal review:</b> Reviews copied from the WRG review history Sheet (Google, South Florida only). Shown: full-text reviews; truncated, off-topic and rating-only entries are left out. No aggregate score is shown or marked up.</span></div>)}
        </div>
      </div>
    </section>

    <section class="sec bg-white" style="--st: clamp(48px, 5cqi, 72px)" aria-labelledby="list">
      <div class="wrap">
        <h2 class="sr" id="list">Selected Google reviews</h2>
        <div class="rev-grid">
          {googleReviews.map((r, i) => <ReviewCard review={r} class={`rv ${delay[i % 3]}`} />)}
        </div>
        <div class="callout" style="margin-top: 24px">
          <div class="stack g8"><p class="h3">See the work behind the feedback.</p><p class="muted">Documented projects, each shown with its real location.</p></div>
          <a class="btn btn-blue" href="/projects/">Projects &amp; Case Studies</a>
        </div>
      </div>
    </section>

    <section class="sec sheet dark cta-band" data-tone="dark" aria-labelledby="cta">
      <div class="wrap">
        <div class="cta-grid">
          <div class="stack g16"><p class="eyebrow">Talk to WRG</p><h2 class="h2" id="cta">Call WRG to discuss your property and the support you need.</h2></div>
          <div class="callcard"><span class="small muted">24/7 Emergency Phone Support</span><a class="num-l" href="tel:+18443799283">(844) 379-9283</a><a class="btn btn-call" href="tel:+18443799283">Call now</a></div>
        </div>
      </div>
    </section>
</BaseLayout>
