---
// Approved photo inside the same .ph frame that PhotoSlot uses, so the frame,
// radius and parallax stay identical. The source file in src/assets/ is kept
// untouched; Astro generates AVIF/WebP/JPEG variants at the listed widths.
// `position` sets the focal point (object-position) for every breakpoint.
// Keep the largest width at or below the source width: it is also the
// size of the fallback <img src>. Pass `widths`, or `max` to derive them.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  max?: number;
  position?: string;
  class?: string;
  style?: string;
  depth?: number;
  mini?: boolean;
  priority?: boolean;
  /** Small visible label over the image, e.g. "Representative image". */
  tag?: string;
}
const { src, alt, sizes, max, position = '50% 50%', class: cls, style, depth, mini = false, priority = false, tag } = Astro.props;
const steps = [400, 720, 960, 1360, 1920, 2400];
const widths = Astro.props.widths ?? (max ? [...steps.filter((w) => w < max - 80), max] : [480, 720, 960, 1360]);
---
<figure class:list={['ph', 'photo', cls, { mini }]} style={style}>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    width={Math.max(...widths)}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    quality={78}
    class="ph-img"
    style={`object-position:${position}`}
    data-depth={depth}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
  {tag && <figcaption class="ph-tag prov"><b>{tag}</b></figcaption>}
</figure>
