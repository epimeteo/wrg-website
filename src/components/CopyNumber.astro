---
// "Copy number" button: copies the phone number and confirms with a drawn check
// and "Copied" for 1.8 s (behavior in src/scripts/site.ts, [data-copy]).
// Hidden until JS confirms clipboard support, so it never shows as a dead button.
import { company } from '../data/site';
interface Props { class?: string; large?: boolean }
const { class: cls, large = false } = Astro.props;
---
<button type="button" class:list={['btn', 'btn-ghost', 'btn-copy', { 'btn-lg': large }, cls]} data-copy={company.phone.display} hidden>
  <span class="copy-ics" aria-hidden="true">
    <svg class="copy-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="8.5" y="8.5" width="11" height="11" rx="2.2"></rect><path d="M15.5 8.5V6.7a2.2 2.2 0 0 0-2.2-2.2H6.7a2.2 2.2 0 0 0-2.2 2.2v6.6a2.2 2.2 0 0 0 2.2 2.2h1.8"></path></svg>
    <svg class="check-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.2 4.2L19 7" pathLength="1"></path></svg>
  </span>
  <span class="copy-label">Copy number</span>
</button>
<span class="sr" role="status" aria-live="polite" data-copy-status></span>
